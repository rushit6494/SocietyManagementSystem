@model List<SocietyManagementSystem.Models.MaintenanceBill>
@{
    ViewData["Title"] = "My Bills";
    Layout = "_Layout";
}

<div class="card-custom">
    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="fas fa-file-invoice fa-3x mb-3" style="color:rgba(255,255,255,0.2)"></i>
            <p style="color:rgba(255,255,255,0.4)">No bills found!</p>
        </div>
    }
    else
    {
        <style>
            .bills-table th, .bills-table td {
                white-space: nowrap;
                vertical-align: middle;
            }
            .status-badge {
                display: inline-block;
                padding: 5px 12px;
                border-radius: 6px;
                font-size: 12px;
                white-space: nowrap;
            }
        </style>
        <div class="table-responsive">
            <table class="table bills-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Month</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Paid On</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>@b.Id</td>
                            <td style="white-space:nowrap;">@b.Month</td>
                            <td style="white-space:nowrap;">₹@b.Amount.ToString("0.##")</td>
                            <td>
                                @if (b.IsPaid)
                                {
                                    <span class="status-badge" style="background:rgba(46,204,113,0.2);color:#2ecc71;"><i class="fas fa-check me-1"></i>Paid</span>
                                }
                                else if (b.PaymentStatus == "Pending Verification")
                                {
                                    <span class="status-badge" style="background:rgba(241,196,15,0.2);color:#f1c40f;"><i class="fas fa-clock me-1"></i>Pending</span>
                                }
                                else
                                {
                                    <span class="status-badge" style="background:rgba(233,69,96,0.2);color:#e94560;"><i class="fas fa-clock me-1"></i>Unpaid</span>
                                }
                            </td>
                            <td style="white-space:nowrap;">@(b.PaidOn.HasValue ? b.PaidOn.Value.ToString("dd MMM yyyy") : "-")</td>
                            <td style="white-space:nowrap;">
                                @if (b.IsPaid)
                                {
                                    <a href="/Bill/DownloadReceipt/@b.Id" class="btn btn-sm btn-primary me-1">
                                        <i class="fas fa-download"></i> Receipt
                                    </a>
                                    <span style="color:#2ecc71;font-size:13px;"><i class="fas fa-check me-1"></i>Paid</span>
                                }
                                else if (b.PaymentStatus == "Pending Verification")
                                {
                                    <span class="status-badge" style="background:rgba(241,196,15,0.2);color:#f1c40f;">
                                        <i class="fas fa-clock me-1"></i>Pending Verification
                                    </span>
                                }
                                else
                                {
                                    <a href="/Bill/PayQR/@b.Id" class="btn btn-success btn-sm" style="white-space:nowrap;padding:6px 10px;font-size:12px;">
    <i class="fas fa-qrcode me-1"></i>Pay Now
</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
