@model List<SocietyManagementSystem.Models.Complaint>
@{
    ViewData["Title"] = "My Complaints";
    Layout = "_Layout";
}

<div class="card-custom mb-4">
    <h5 style="color:#e94560;margin-bottom:20px;"><i class="fas fa-plus me-2"></i>Raise New Complaint</h5>
    <form method="post" action="/ResidentPanel/AddComplaint">
        <input type="hidden" name="residentId" value="@ViewBag.ResidentId" />
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" name="title" class="form-control" placeholder="Complaint title" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3" placeholder="Describe your complaint" required></textarea>
        </div>
        <button type="submit" class="btn-save">
            <i class="fas fa-paper-plane me-2"></i>Submit Complaint
        </button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="card-custom text-center py-4">
        <i class="fas fa-exclamation-circle fa-3x mb-3" style="color:rgba(255,255,255,0.2)"></i>
        <p style="color:rgba(255,255,255,0.4)">No complaints found!</p>
    </div>
}
else
{
    @foreach (var c in Model)
    {
        <div class="card-custom mb-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h6 style="color:#fff;margin:0 0 4px;font-size:14px;font-weight:600;word-wrap:break-word;overflow-wrap:break-word;">@c.Title</h6>
                @if (c.Status == "Resolved")
                {
                    <span style="background:rgba(46,204,113,0.2);color:#2ecc71;padding:4px 10px;border-radius:20px;font-size:11px;white-space:nowrap;">✅ Resolved</span>
                }
                else if (c.Status == "In Progress")
                {
                    <span style="background:rgba(241,196,15,0.2);color:#f1c40f;padding:4px 10px;border-radius:20px;font-size:11px;white-space:nowrap;">⏳ In Progress</span>
                }
                else
                {
                    <span style="background:rgba(233,69,96,0.2);color:#e94560;padding:4px 10px;border-radius:20px;font-size:11px;white-space:nowrap;">🕐 Pending</span>
                }
            </div>
            <p style="color:rgba(255,255,255,0.6);font-size:13px;margin:0 0 8px;word-wrap:break-word;overflow-wrap:break-word;white-space:normal;">@c.Description</p>
            <small style="color:rgba(255,255,255,0.3);font-size:11px;"><i class="fas fa-calendar me-1"></i>@c.CreatedAt.ToString("dd MMM yyyy")</small>
        </div>
    }
}