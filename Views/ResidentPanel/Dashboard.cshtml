@{
    ViewData["Title"] = "My Dashboard";
    Layout = "_Layout";
}

<div class="welcome-card" style="background: linear-gradient(135deg, #3498db, #2980b9); border-radius: 16px; padding: 25px 30px; margin-bottom: 30px;">
    <h3 style="color:#fff; font-weight:700; margin:0;">Welcome, @ViewBag.Resident.Name! 👋</h3>
    <p style="color:rgba(255,255,255,0.8); margin:5px 0 0;">Flat No: @ViewBag.Resident.FlatNumber</p>
</div>

<div class="row g-3">
    <div class="col-6 col-md-3">
        <div class="card-custom mb-0">
            <div style="width:50px;height:50px;border-radius:14px;background:rgba(52,152,219,0.2);color:#3498db;display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:12px;">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div style="font-size:30px;font-weight:700;">@ViewBag.TotalBills</div>
            <div style="color:rgba(255,255,255,0.5);font-size:13px;">Total Bills</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card-custom mb-0">
            <div style="width:50px;height:50px;border-radius:14px;background:rgba(233,69,96,0.2);color:#e94560;display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:12px;">
                <i class="fas fa-money-bill-wave"></i>
            </div>
            <div style="font-size:30px;font-weight:700;">@ViewBag.UnpaidBills</div>
            <div style="color:rgba(255,255,255,0.5);font-size:13px;">Unpaid Bills</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card-custom mb-0">
            <div style="width:50px;height:50px;border-radius:14px;background:rgba(241,196,15,0.2);color:#f1c40f;display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:12px;">
                <i class="fas fa-exclamation-circle"></i>
            </div>
            <div style="font-size:30px;font-weight:700;">@ViewBag.TotalComplaints</div>
            <div style="color:rgba(255,255,255,0.5);font-size:13px;">Total Complaints</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card-custom mb-0">
            <div style="width:50px;height:50px;border-radius:14px;background:rgba(231,76,60,0.2);color:#e74c3c;display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:12px;">
                <i class="fas fa-clock"></i>
            </div>
            <div style="font-size:30px;font-weight:700;">@ViewBag.PendingComplaints</div>
            <div style="color:rgba(255,255,255,0.5);font-size:13px;">Pending Complaints</div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12 col-md-4 mb-3">
        <a href="/ResidentPanel/MyBills" class="card-custom d-block text-decoration-none h-100" style="transition:transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
            <i class="fas fa-file-invoice-dollar fa-2x mb-3" style="color:#3498db;"></i>
            <h5 style="color:#fff;">My Bills</h5>
            <p style="color:rgba(255,255,255,0.5);font-size:13px;margin:0;">View &amp; track your maintenance bills</p>
        </a>
    </div>
    <div class="col-12 col-md-4 mb-3">
        <a href="/ResidentPanel/MyComplaints" class="card-custom d-block text-decoration-none h-100" style="transition:transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
            <i class="fas fa-exclamation-circle fa-2x mb-3" style="color:#e94560;"></i>
            <h5 style="color:#fff;">My Complaints</h5>
            <p style="color:rgba(255,255,255,0.5);font-size:13px;margin:0;">Raise &amp; track your complaints</p>
        </a>
    </div>
    <div class="col-12 col-md-4 mb-3">
        <a href="/ResidentPanel/MyNotices" class="card-custom d-block text-decoration-none h-100" style="transition:transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
            <i class="fas fa-bullhorn fa-2x mb-3" style="color:#9b59b6;"></i>
            <h5 style="color:#fff;">Notices</h5>
            <p style="color:rgba(255,255,255,0.5);font-size:13px;margin:0;">View society announcements</p>
        </a>
    </div>
</div>
