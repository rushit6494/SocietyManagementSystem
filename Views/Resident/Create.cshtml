@{
    ViewData["Title"] = "Add Resident";
    Layout = "_Layout";
}

<div class="form-card" style="max-width:700px;">
    <form method="post" action="/Resident/Create">
        <div class="section-title">Personal Information</div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" name="Name" class="form-control" placeholder="Enter full name" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Phone Number</label>
                <input type="text" name="Phone" class="form-control" placeholder="Enter phone number" required />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Flat Number</label>
                <input type="text" name="FlatNumber" class="form-control" placeholder="e.g. A-101" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Address</label>
                <input type="text" name="Address" class="form-control" placeholder="Enter address" />
            </div>
        </div>

        <div class="section-title">Login Credentials</div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="Enter email" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Set password" required />
            </div>
        </div>

        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn-save">
                <i class="fas fa-save me-2"></i>Save Resident
            </button>
            <a href="/Resident/Index" class="btn-back">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </form>
</div>