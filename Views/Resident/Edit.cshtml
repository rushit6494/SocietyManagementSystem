@model SocietyManagementSystem.Models.Resident
@{
    ViewData["Title"] = "Edit Resident";
    Layout = "_Layout";
}

<div class="form-card" style="max-width:700px;">
    <form method="post" action="/Resident/Edit/@Model.Id">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="UserId" value="@Model.UserId" />
        <input type="hidden" name="JoinDate" value="@Model.JoinDate" />

        <div class="section-title">Personal Information</div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Phone Number</label>
                <input type="text" name="Phone" class="form-control" value="@Model.Phone" required />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Flat Number</label>
                <input type="text" name="FlatNumber" class="form-control" value="@Model.FlatNumber" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="Email" class="form-control" value="@Model.Email" required />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Address</label>
            <input type="text" name="Address" class="form-control" value="@Model.Address" />
        </div>

        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn-save">
                <i class="fas fa-save me-2"></i>Update Resident
            </button>
            <a href="/Resident/Index" class="btn-back">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </form>
</div>