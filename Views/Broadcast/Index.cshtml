@{
    ViewData["Title"] = "Broadcast Message";
    Layout = "_Layout";
}

@if (TempData["Success"] != null)
{
    <div class="alert mb-3" style="background:rgba(46,204,113,0.15);border:1px solid rgba(46,204,113,0.3);color:#2ecc71;border-radius:10px;padding:15px;">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
    </div>
}

<div class="form-card" style="max-width:650px;">
    <h5 style="color:#00c6ff;margin-bottom:5px;"><i class="fas fa-broadcast-tower me-2"></i>Broadcast Message</h5>
    <p style="color:rgba(255,255,255,0.4);font-size:13px;margin-bottom:25px;">Send message to all registered residents via email</p>

    <form method="post" action="/Broadcast/Send">
        <div class="mb-3">
            <label class="form-label">Subject</label>
            <input type="text" name="subject" class="form-control" placeholder="Enter message subject" required />
        </div>
        <div class="mb-4">
            <label class="form-label">Message</label>
            <textarea name="message" class="form-control" rows="6" placeholder="Type your message here..." required></textarea>
        </div>
        <div class="d-flex gap-3">
            <button type="submit" class="btn-save">
                <i class="fas fa-paper-plane me-2"></i>Send to All Residents
            </button>
            <a href="/Admin/Index" class="btn-back">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </form>
</div>