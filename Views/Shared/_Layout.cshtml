<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Society MS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #0a0e1a; font-family: 'Segoe UI', sans-serif; min-height: 100vh; color: #fff; }
        .top-navbar {
            background: linear-gradient(90deg, #0a0e1a 0%, #1a2744 50%, #0a0e1a 100%);
            padding: 0 30px; height: 65px;
            display: flex; align-items: center; justify-content: space-between;
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            border-bottom: 1px solid rgba(0,198,255,0.15);
            box-shadow: 0 2px 30px rgba(0,0,0,0.5);
        }
        .navbar-brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
        .navbar-brand .logo-icon {
            width: 42px; height: 42px; flex-shrink: 0;
            background: linear-gradient(135deg, #00c6ff, #0072ff); border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; color: #fff; box-shadow: 0 4px 15px rgba(0,198,255,0.4);
        }
        .navbar-brand .brand-text { color: #fff; font-size: 20px; font-weight: 700; }
        .navbar-brand .brand-sub { color: rgba(0,198,255,0.7); font-size: 11px; display: block; margin-top: -3px; }
        .nav-links { display: flex; align-items: center; gap: 3px; list-style: none; margin: 0; padding: 0; }
        .nav-links a {
            color: rgba(255,255,255,0.7); text-decoration: none;
            padding: 8px 14px; border-radius: 8px; font-size: 13px;
            display: flex; align-items: center; gap: 7px;
            transition: all 0.3s; border: 1px solid transparent; white-space: nowrap;
        }
        .nav-links a:hover { background: rgba(0,198,255,0.1); color: #00c6ff; border-color: rgba(0,198,255,0.2); }
        .nav-links a.active { background: linear-gradient(135deg, rgba(0,198,255,0.2), rgba(0,114,255,0.2)); color: #00c6ff; border-color: rgba(0,198,255,0.3); }
        .nav-links a i { font-size: 13px; }
        .navbar-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
        .user-badge {
            display: flex; align-items: center; gap: 10px;
            background: rgba(255,255,255,0.05); padding: 7px 14px;
            border-radius: 10px; border: 1px solid rgba(0,198,255,0.15);
        }
        .user-avatar {
            width: 32px; height: 32px; flex-shrink: 0;
            background: linear-gradient(135deg, #00c6ff, #0072ff); border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; color: #fff; font-weight: 700;
        }
        .user-name { color: #fff; font-size: 13px; font-weight: 600; }
        .user-role { color: rgba(0,198,255,0.7); font-size: 11px; }
        .btn-logout-nav {
            background: linear-gradient(135deg, #00c6ff, #0072ff);
            border: none; color: #fff; padding: 8px 18px; border-radius: 8px;
            text-decoration: none; font-size: 13px; font-weight: 600;
            transition: all 0.3s; display: flex; align-items: center; gap: 6px;
            box-shadow: 0 4px 15px rgba(0,198,255,0.3); white-space: nowrap;
        }
        .btn-logout-nav:hover { opacity: 0.85; color: #fff; transform: translateY(-1px); }
        /* HAMBURGER */
        .hamburger-btn {
            display: none; background: rgba(255,255,255,0.05);
            border: 1px solid rgba(0,198,255,0.2); color: #fff;
            width: 40px; height: 40px; border-radius: 8px;
            align-items: center; justify-content: center;
            cursor: pointer; font-size: 18px; transition: all 0.3s; flex-shrink: 0;
        }
        .hamburger-btn:hover { background: rgba(0,198,255,0.1); color: #00c6ff; }
        /* MOBILE DRAWER */
        .mobile-drawer {
            display: none; position: fixed;
            top: 65px; left: 0; right: 0;
            background: linear-gradient(180deg, #0f1629 0%, #1a2744 100%);
            border-bottom: 1px solid rgba(0,198,255,0.15);
            z-index: 999; padding: 15px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.5);
            max-height: calc(100vh - 65px); overflow-y: auto;
        }
        .mobile-drawer.open { display: block; }
        .mobile-nav-links { list-style: none; padding: 0; margin: 0; }
        .mobile-nav-links li { margin-bottom: 4px; }
        .mobile-nav-links a {
            color: rgba(255,255,255,0.7); text-decoration: none;
            padding: 12px 16px; border-radius: 10px; font-size: 14px;
            display: flex; align-items: center; gap: 10px;
            transition: all 0.2s; border: 1px solid transparent;
        }
        .mobile-nav-links a:hover, .mobile-nav-links a.active {
            background: rgba(0,198,255,0.1); color: #00c6ff; border-color: rgba(0,198,255,0.2);
        }
        .mobile-nav-links a i { width: 18px; text-align: center; font-size: 14px; }
        .mobile-drawer-footer {
            margin-top: 15px; padding-top: 15px;
            border-top: 1px solid rgba(0,198,255,0.1);
            display: flex; align-items: center; justify-content: space-between;
        }
        /* MAIN */
        .main-wrapper { margin-top: 65px; padding: 30px; min-height: calc(100vh - 65px); }
        .page-header { margin-bottom: 25px; }
        .page-header h2 { color: #fff; font-weight: 700; font-size: 24px; }
        .page-header p { color: rgba(255,255,255,0.4); font-size: 14px; margin: 0; }
        .stat-card {
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            border-radius: 16px; padding: 25px;
            box-shadow: 0 4px 20px rgba(0,198,255,0.1);
            border: 1px solid rgba(0,198,255,0.1);
            transition: all 0.3s; cursor: pointer;
            text-decoration: none; display: block;
            position: relative; overflow: hidden; margin-bottom: 20px;
        }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 8px 30px rgba(0,198,255,0.2); text-decoration: none; }
        .stat-number { font-size: 36px; font-weight: 700; color: #fff !important; margin: 12px 0 5px; }
        .stat-label { color: rgba(255,255,255,0.6) !important; font-size: 13px; font-weight: 500; }
        .stat-arrow { position: absolute; top: 20px; right: 20px; color: rgba(255,255,255,0.2); font-size: 16px; transition: all 0.3s; }
        .stat-card:hover .stat-arrow { color: rgba(255,255,255,0.6); right: 15px; }
        .stat-icon { width: 55px; height: 55px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
        .welcome-card {
            background: linear-gradient(135deg, #e94560, #c62a47);
            border-radius: 16px; padding: 25px 30px; margin-bottom: 25px;
            box-shadow: 0 4px 20px rgba(233,69,96,0.3); border: 1px solid rgba(255,255,255,0.1);
        }
        .welcome-card h3 { color: #fff; font-weight: 700; margin: 0; font-size: 22px; }
        .welcome-card p { color: rgba(255,255,255,0.8); margin: 5px 0 0; }
        .card-custom {
            background: linear-gradient(135deg, #0f1629, #1a2744);
            border-radius: 16px; padding: 25px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            border: 1px solid rgba(0,198,255,0.1); margin-bottom: 20px; color: #fff;
        }
        .table { color: #fff !important; }
        .table * { color: #fff !important; }
        .table thead th {
            background: linear-gradient(135deg, #0f1629, #1a2744) !important;
            color: #00c6ff !important; border-color: rgba(0,198,255,0.15) !important;
            font-size: 13px; padding: 12px 15px; font-weight: 600;
        }
        .table tbody td {
            border-color: rgba(255,255,255,0.05) !important;
            vertical-align: middle; font-size: 14px; padding: 12px 15px;
            color: #fff !important; background: transparent !important;
        }
        .table tbody tr { background: rgba(255,255,255,0.02) !important; }
        .table tbody tr:hover { background: rgba(0,198,255,0.05) !important; }
        .table-striped > tbody > tr:nth-of-type(odd) > * { color: #fff !important; }
        .table-responsive { border-radius: 8px; }
        .btn-add {
            background: linear-gradient(135deg, #00c6ff, #0072ff);
            border: none; color: #fff !important; padding: 10px 20px; border-radius: 10px;
            text-decoration: none; font-size: 14px; font-weight: 600;
            display: inline-flex; align-items: center; gap: 7px; transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(0,198,255,0.3);
        }
        .btn-add:hover { color: #fff !important; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,198,255,0.4); }
        .btn-save {
            background: linear-gradient(135deg, #00c6ff, #0072ff); border: none;
            color: #fff !important; padding: 12px 30px; border-radius: 10px;
            font-weight: 600; font-size: 15px; transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(0,198,255,0.3); cursor: pointer;
        }
        .btn-save:hover { color: #fff !important; transform: translateY(-2px); }
        .btn-back {
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.7) !important; padding: 12px 25px;
            border-radius: 10px; text-decoration: none; font-size: 15px; transition: all 0.3s;
        }
        .btn-back:hover { background: rgba(255,255,255,0.1); color: #fff !important; }
        .form-control, .form-select {
            background: rgba(255,255,255,0.05) !important; border: 1.5px solid rgba(0,198,255,0.2) !important;
            border-radius: 10px; color: #fff !important; padding: 12px 15px; font-size: 14px; transition: all 0.3s;
        }
        .form-control:focus, .form-select:focus {
            background: rgba(0,198,255,0.05) !important; border-color: #00c6ff !important;
            color: #fff !important; box-shadow: 0 0 0 3px rgba(0,198,255,0.1) !important;
        }
        .form-control::placeholder { color: rgba(255,255,255,0.3) !important; }
        .form-label { color: rgba(255,255,255,0.8) !important; font-size: 14px; font-weight: 600; margin-bottom: 6px; }
        .form-select option { background: #1a2744 !important; color: #fff !important; }
        .form-card {
            background: linear-gradient(135deg, #0f1629, #1a2744); border-radius: 16px; padding: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3); border: 1px solid rgba(0,198,255,0.1); color: #fff;
        }
        .section-title {
            color: #00c6ff !important; font-size: 12px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 15px; margin-top: 20px;
            padding-bottom: 8px; border-bottom: 1px solid rgba(0,198,255,0.2);
        }
        .badge-paid { background: rgba(46,204,113,0.15); color: #2ecc71 !important; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; border: 1px solid rgba(46,204,113,0.3); }
        .badge-unpaid { background: rgba(233,69,96,0.15); color: #e94560 !important; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; border: 1px solid rgba(233,69,96,0.3); }
        .badge-pending { background: rgba(241,196,15,0.15); color: #f1c40f !important; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; border: 1px solid rgba(241,196,15,0.3); }
        .badge-flat { background: rgba(0,198,255,0.15); color: #00c6ff !important; padding: 5px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; }
        .text-dark, h1, h2, h3, h4, h5, h6, p, span, td, th, label, a { color: inherit; }
        input, textarea, select { color: #fff !important; }

        /* ========== RESPONSIVE ========== */
        @@media (max-width: 1100px) {
            .nav-links { display: none; }
            .hamburger-btn { display: flex; }
            .top-navbar { padding: 0 20px; }
        }
        @@media (max-width: 768px) {
            .top-navbar { padding: 0 15px; }
            .navbar-brand .brand-text { font-size: 17px; }
            .navbar-brand .logo-icon { width: 38px; height: 38px; font-size: 16px; }
            .user-role { display: none; }
            .user-badge { padding: 5px 10px; }
            .user-name { font-size: 12px; max-width: 90px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
            .btn-logout-nav { padding: 7px 13px; font-size: 12px; }
            .main-wrapper { padding: 15px; }
            .page-header h2 { font-size: 20px; }
            .stat-card { padding: 18px; margin-bottom: 12px; }
            .stat-number { font-size: 28px; }
            .stat-icon { width: 45px; height: 45px; font-size: 18px; }
            .welcome-card { padding: 18px 20px; }
            .welcome-card h3 { font-size: 18px; }
            .card-custom { padding: 15px; }
            .form-card { padding: 20px; }
            .table { font-size: 12px; }
            .table thead th { padding: 8px 8px; font-size: 11px; }
            .table tbody td { padding: 8px 8px; font-size: 12px; }
            .btn-add { padding: 8px 14px; font-size: 13px; }
            .btn-save { padding: 10px 20px; font-size: 14px; }
        }
        @@media (max-width: 480px) {
            .navbar-brand .brand-sub { display: none; }
            .btn-logout-nav .logout-text { display: none; }
            .main-wrapper { padding: 10px; }
            .stat-number { font-size: 24px; }
            .welcome-card h3 { font-size: 16px; }
        }
    </style>
</head>
<body>
    <nav class="top-navbar">
        <a href="@(Context.Session.GetString("UserRole") == "Admin" ? "/Admin/Index" : "/ResidentPanel/Dashboard")" class="navbar-brand">
            <div class="logo-icon"><i class="fas fa-building"></i></div>
            <div>
                <span class="brand-text">Society MS</span>
                <span class="brand-sub">@(Context.Session.GetString("UserRole") == "Admin" ? "Admin Panel" : "Resident Panel")</span>
            </div>
        </a>

        @if (Context.Session.GetString("UserRole") == "Admin")
        {
            <ul class="nav-links">
                <li><a href="/Admin/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                <li><a href="/Resident/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Resident" ? "active" : "")"><i class="fas fa-users"></i> Residents</a></li>
                <li><a href="/Bill/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Bill" ? "active" : "")"><i class="fas fa-file-invoice-dollar"></i> Bills</a></li>
                <li><a href="/Complaint/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Complaint" ? "active" : "")"><i class="fas fa-exclamation-circle"></i> Complaints</a></li>
                <li><a href="/Notice/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Notice" ? "active" : "")"><i class="fas fa-bullhorn"></i> Notices</a></li>
                <li><a href="/Parking/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Parking" ? "active" : "")"><i class="fas fa-parking"></i> Parking</a></li>
                <li><a href="/Visitor/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Visitor" ? "active" : "")"><i class="fas fa-user-check"></i> Visitors</a></li>
                <li><a href="/Broadcast/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Broadcast" ? "active" : "")"><i class="fas fa-broadcast-tower"></i> Broadcast</a></li>
            </ul>
        }
        else
        {
            <ul class="nav-links">
                <li><a href="/ResidentPanel/Dashboard" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                <li><a href="/ResidentPanel/MyBills" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MyBills" ? "active" : "")"><i class="fas fa-file-invoice-dollar"></i> My Bills</a></li>
                <li><a href="/ResidentPanel/MyComplaints" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MyComplaints" ? "active" : "")"><i class="fas fa-exclamation-circle"></i> Complaints</a></li>
                <li><a href="/ResidentPanel/MyNotices" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MyNotices" ? "active" : "")"><i class="fas fa-bullhorn"></i> Notices</a></li>
                <li><a href="/ResidentPanel/Profile" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")"><i class="fas fa-user"></i> My Profile</a></li>
            </ul>
        }

        <div class="navbar-right">
            <div class="user-badge">
                <div class="user-avatar">@(Context.Session.GetString("UserName")?[0].ToString().ToUpper() ?? "U")</div>
                <div>
                    <div class="user-name">@Context.Session.GetString("UserName")</div>
                    <div class="user-role">@Context.Session.GetString("UserRole")</div>
                </div>
            </div>
            <a href="/Account/Logout" class="btn-logout-nav">
                <i class="fas fa-sign-out-alt"></i> <span class="logout-text">Logout</span>
            </a>
            <button class="hamburger-btn" id="hamburgerBtn" onclick="toggleDrawer()">
                <i class="fas fa-bars" id="hamburgerIcon"></i>
            </button>
        </div>
    </nav>

    <div class="mobile-drawer" id="mobileDrawer">
        @if (Context.Session.GetString("UserRole") == "Admin")
        {
            <ul class="mobile-nav-links">
                <li><a href="/Admin/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                <li><a href="/Resident/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Resident" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-users"></i> Residents</a></li>
                <li><a href="/Bill/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Bill" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-file-invoice-dollar"></i> Bills</a></li>
                <li><a href="/Complaint/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Complaint" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-exclamation-circle"></i> Complaints</a></li>
                <li><a href="/Notice/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Notice" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-bullhorn"></i> Notices</a></li>
                <li><a href="/Parking/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Parking" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-parking"></i> Parking</a></li>
                <li><a href="/Visitor/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Visitor" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-user-check"></i> Visitors</a></li>
                <li><a href="/Broadcast/Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Broadcast" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-broadcast-tower"></i> Broadcast</a></li>
            </ul>
        }
        else
        {
            <ul class="mobile-nav-links">
                <li><a href="/ResidentPanel/Dashboard" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                <li><a href="/ResidentPanel/MyBills" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MyBills" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-file-invoice-dollar"></i> My Bills</a></li>
                <li><a href="/ResidentPanel/MyComplaints" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MyComplaints" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-exclamation-circle"></i> Complaints</a></li>
                <li><a href="/ResidentPanel/MyNotices" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "MyNotices" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-bullhorn"></i> Notices</a></li>
                <li><a href="/ResidentPanel/Profile" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")" onclick="closeDrawer()"><i class="fas fa-user"></i> My Profile</a></li>
            </ul>
        }
        <div class="mobile-drawer-footer">
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="user-avatar">@(Context.Session.GetString("UserName")?[0].ToString().ToUpper() ?? "U")</div>
                <div>
                    <div style="color:#fff;font-size:13px;font-weight:600;">@Context.Session.GetString("UserName")</div>
                    <div style="color:rgba(0,198,255,0.7);font-size:11px;">@Context.Session.GetString("UserRole")</div>
                </div>
            </div>
            <a href="/Account/Logout" class="btn-logout-nav">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <div class="main-wrapper">
        <div class="page-header">
            <h2>@ViewData["Title"]</h2>
        </div>
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleDrawer() {
            var drawer = document.getElementById('mobileDrawer');
            var icon = document.getElementById('hamburgerIcon');
            drawer.classList.toggle('open');
            icon.className = drawer.classList.contains('open') ? 'fas fa-times' : 'fas fa-bars';
        }
        function closeDrawer() {
            var drawer = document.getElementById('mobileDrawer');
            var icon = document.getElementById('hamburgerIcon');
            drawer.classList.remove('open');
            icon.className = 'fas fa-bars';
        }
        document.addEventListener('click', function(e) {
            var drawer = document.getElementById('mobileDrawer');
            var btn = document.getElementById('hamburgerBtn');
            if (drawer && drawer.classList.contains('open') && !drawer.contains(e.target) && !btn.contains(e.target)) {
                closeDrawer();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
