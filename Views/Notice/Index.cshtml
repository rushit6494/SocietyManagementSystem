@model List<SocietyManagementSystem.Models.Notice>
@{
    ViewData["Title"] = "Notices";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a href="/Notice/Create" class="btn-add">
        <i class="fas fa-plus me-1"></i> Add Notice
    </a>
</div>

<div class="card-custom">
    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="fas fa-bullhorn fa-3x mb-3" style="color:rgba(255,255,255,0.2)"></i>
            <p style="color:rgba(255,255,255,0.4)">No notices found!</p>
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Title</th>
                    <th>Content</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Expiry</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model)
                {
                    <tr>
                        <td>@n.Id</td>
                        <td>@n.Title</td>
                        <td>@n.Content</td>
                        <td>
                            @if (n.Category == "Urgent")
                            {
                                <span style="background:rgba(233,69,96,0.2);color:#e94560;padding:5px 10px;border-radius:6px;font-size:12px;">Urgent</span>
                            }
                            else if (n.Category == "Event")
                            {
                                <span style="background:rgba(52,152,219,0.2);color:#3498db;padding:5px 10px;border-radius:6px;font-size:12px;">Event</span>
                            }
                            else
                            {
                                <span style="background:rgba(46,204,113,0.2);color:#2ecc71;padding:5px 10px;border-radius:6px;font-size:12px;">General</span>
                            }
                        </td>
                        <td>@n.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>@(n.ExpiryDate.HasValue ? n.ExpiryDate.Value.ToString("dd MMM yyyy") : "-")</td>
                        <td>
                            <form method="post" action="/Notice/Delete/@n.Id" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>