@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Society MS - Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            min-height: 100vh;
            background: #0a0e1a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
            position: relative;
            overflow: hidden;
        }
        body::before {
            content: '';
            position: absolute;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(0,198,255,0.1), transparent 70%);
            top: -100px; left: -100px;
        }
        body::after {
            content: '';
            position: absolute;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(0,114,255,0.08), transparent 70%);
            bottom: -50px; right: -50px;
        }
        .login-wrapper {
            display: flex;
            width: 900px;
            min-height: 550px;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0,0,0,0.5);
            z-index: 1;
        }
        .login-left {
            flex: 1;
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            border-right: 1px solid rgba(0,198,255,0.1);
        }
        .login-left .logo {
            width: 80px; height: 80px;
            background: linear-gradient(135deg, #00c6ff, #0072ff);
            border-radius: 20px;
            display: flex; align-items: center; justify-content: center;
            font-size: 35px; color: #fff;
            margin: 0 auto 25px;
            box-shadow: 0 10px 30px rgba(0,198,255,0.3);
        }
        .login-left h2 { color: #fff; font-weight: 700; font-size: 26px; margin-bottom: 10px; }
        .login-left p { color: rgba(255,255,255,0.5); font-size: 14px; line-height: 1.7; }
        .login-left .features { margin-top: 30px; text-align: left; width: 100%; }
        .login-left .feature-item {
            display: flex; align-items: center; gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            color: rgba(255,255,255,0.7);
            font-size: 13px;
        }
        .login-left .feature-item i { color: #00c6ff; width: 20px; }
        .login-right {
            flex: 1;
            background: linear-gradient(135deg, #0a0e1a, #111827);
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .login-right h3 { color: #fff; font-weight: 700; font-size: 24px; margin-bottom: 5px; }
        .login-right p { color: rgba(255,255,255,0.4); font-size: 14px; margin-bottom: 30px; }
        .form-control {
            background: rgba(255,255,255,0.05);
            border: 1.5px solid rgba(0,198,255,0.2);
            border-radius: 10px; color: #fff;
            padding: 12px 15px; font-size: 14px;
        }
        .form-control:focus {
            background: rgba(0,198,255,0.05);
            border-color: #00c6ff; color: #fff;
            box-shadow: 0 0 0 3px rgba(0,198,255,0.1);
        }
        .form-control::placeholder { color: rgba(255,255,255,0.3); }
        .form-label { color: rgba(255,255,255,0.7); font-size: 13px; font-weight: 600; margin-bottom: 6px; }
        .btn-login {
            background: linear-gradient(135deg, #00c6ff, #0072ff);
            border: none; color: #fff;
            padding: 13px; width: 100%;
            border-radius: 10px; font-weight: 700;
            font-size: 15px; transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(0,198,255,0.3);
        }
        .btn-login:hover { opacity: 0.9; color: #fff; transform: translateY(-2px); }
        .link-style { color: #00c6ff; text-decoration: none; font-size: 13px; }
        .link-style:hover { color: #66d9ff; }
        .alert-danger { background: rgba(233,69,96,0.15); border: 1px solid rgba(233,69,96,0.3); color: #ff6b81; border-radius: 10px; font-size: 13px; }
        .alert-success { background: rgba(0,198,255,0.1); border: 1px solid rgba(0,198,255,0.3); color: #00c6ff; border-radius: 10px; font-size: 13px; }
        .divider { display: flex; align-items: center; gap: 10px; margin: 20px 0; }
        .divider hr { flex: 1; border-color: rgba(255,255,255,0.1); }
        .divider span { color: rgba(255,255,255,0.3); font-size: 12px; }

        /* ===== MOBILE ONLY ===== */
        @@media (max-width: 768px) {
            body { align-items: flex-start; padding: 0; overflow-y: auto; }
            .login-wrapper {
                flex-direction: column;
                width: 100%;
                min-height: 100vh;
                border-radius: 0;
                box-shadow: none;
            }
            .login-left {
                padding: 30px 24px 25px;
                border-right: none;
                border-bottom: 1px solid rgba(0,198,255,0.1);
            }
            .login-left .logo { width: 60px; height: 60px; font-size: 26px; margin-bottom: 15px; }
            .login-left h2 { font-size: 22px; margin-bottom: 6px; }
            .login-left p { font-size: 13px; }
            .login-left .features { margin-top: 18px; }
            .login-left .feature-item { padding: 8px 0; font-size: 13px; }
            .login-right {
                padding: 30px 24px 40px;
                justify-content: flex-start;
            }
            .login-right h3 { font-size: 22px; }
            .login-right > p { margin-bottom: 22px; }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-left">
            <div class="logo"><i class="fas fa-building"></i></div>
            <h2>Society MS</h2>
            <p>Complete Society Management Solution for modern residential communities</p>
            <div class="features">
                <div class="feature-item"><i class="fas fa-check-circle"></i> Resident Management</div>
                <div class="feature-item"><i class="fas fa-check-circle"></i> Maintenance Bills & Payments</div>
                <div class="feature-item"><i class="fas fa-check-circle"></i> Complaint Tracking</div>
                <div class="feature-item"><i class="fas fa-check-circle"></i> Notice Board</div>
                <div class="feature-item"><i class="fas fa-check-circle"></i> Parking & Visitor Management</div>
            </div>
        </div>
        <div class="login-right">
            <h3>Welcome Back! 👋</h3>
            <p>Sign in to your account to continue</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mb-3"><i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error</div>
            }
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success mb-3"><i class="fas fa-check-circle me-2"></i>@ViewBag.Success</div>
            }

            <form method="post" action="/Account/Login">
                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="email" class="form-control" placeholder="Enter your email" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" placeholder="Enter your password" required />
                </div>
                <div class="d-flex justify-content-end mb-4">
                    <a href="/Account/ForgotPassword" class="link-style"><i class="fas fa-key me-1"></i>Forgot Password?</a>
                </div>
                <button type="submit" class="btn-login mb-4">
                    <i class="fas fa-sign-in-alt me-2"></i>Sign In
                </button>
                <div class="divider"><hr/><span>OR</span><hr/></div>
                <div class="text-center">
                    <span style="color:rgba(255,255,255,0.4);font-size:13px;">Don't have an account?</span>
                    <a href="/Account/Register" class="link-style ms-2"><i class="fas fa-user-plus me-1"></i>Create Account</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
