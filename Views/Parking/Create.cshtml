@{
    ViewData["Title"] = "Add Parking Slot";
    Layout = "_Layout";
}

<div class="form-card" style="max-width:600px;">
    <form method="post" action="/Parking/Create">
        <div class="mb-3">
            <label class="form-label">Slot Number</label>
            <input type="text" name="SlotNumber" class="form-control" placeholder="e.g. P-01" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Vehicle Type</label>
            <select name="VehicleType" class="form-select">
                <option value="Car">Car</option>
                <option value="Bike">Bike</option>
                <option value="Other">Other</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Vehicle Number</label>
            <input type="text" name="VehicleNumber" class="form-control" placeholder="e.g. GJ-01-AB-1234" />
        </div>
        <div class="mb-3">
            <label class="form-label">Assign to Resident (Optional)</label>
            <select name="ResidentId" class="form-select">
                <option value="">-- Not Assigned --</option>
                @foreach (var r in ViewBag.Residents)
                {
                    <option value="@r.Id">@r.Name - Flat @r.FlatNumber</option>
                }
            </select>
        </div>
        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn-save">
                <i class="fas fa-save me-2"></i>Add Slot
            </button>
            <a href="/Parking/Index" class="btn-back">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </form>
</div>