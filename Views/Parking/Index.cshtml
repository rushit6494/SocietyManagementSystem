@model List<SocietyManagementSystem.Models.ParkingSlot>
@{
    ViewData["Title"] = "Parking Management";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a href="/Parking/Create" class="btn-add">
        <i class="fas fa-plus me-1"></i> Add Parking Slot
    </a>
</div>

<div class="card-custom">
    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="fas fa-parking fa-3x mb-3" style="color:rgba(255,255,255,0.2)"></i>
            <p style="color:rgba(255,255,255,0.4)">No parking slots found!</p>
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Slot No</th>
                    <th>Vehicle Type</th>
                    <th>Vehicle No</th>
                    <th>Resident</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.SlotNumber</td>
                        <td>@p.VehicleType</td>
                        <td>@p.VehicleNumber</td>
                        <td>@(p.Resident?.Name ?? "-")</td>
                        <td>
                            @if (p.IsOccupied)
                            {
                                <span style="background:rgba(233,69,96,0.2);color:#e94560;padding:5px 10px;border-radius:6px;font-size:12px;">Occupied</span>
                            }
                            else
                            {
                                <span style="background:rgba(46,204,113,0.2);color:#2ecc71;padding:5px 10px;border-radius:6px;font-size:12px;">Available</span>
                            }
                        </td>
                        <td>
                            <form method="post" action="/Parking/Delete/@p.Id" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>