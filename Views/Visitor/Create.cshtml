@{
    ViewData["Title"] = "Add Visitor";
    Layout = "_Layout";
}

<div class="form-card" style="max-width:600px;">
    <form method="post" action="/Visitor/Create">
        <div class="mb-3">
            <label class="form-label">Visitor Name</label>
            <input type="text" name="Name" class="form-control" placeholder="Enter visitor name" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Phone Number</label>
            <input type="text" name="Phone" class="form-control" placeholder="Enter phone number" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Purpose of Visit</label>
            <input type="text" name="Purpose" class="form-control" placeholder="e.g. Meeting, Delivery" />
        </div>
        <div class="mb-3">
            <label class="form-label">Visiting Resident</label>
            <select name="ResidentId" class="form-select" required>
                <option value="">-- Select Resident --</option>
                @foreach (var r in ViewBag.Residents)
                {
                    <option value="@r.Id">@r.Name - Flat @r.FlatNumber</option>
                }
            </select>
        </div>
        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn-save">
                <i class="fas fa-save me-2"></i>Add Visitor
            </button>
            <a href="/Visitor/Index" class="btn-back">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </form>
</div>