@{
    ViewData["Title"] = "Generate Bill for All";
    Layout = "_Layout";
}

@if (TempData["Success"] != null)
{
    <div class="alert" style="background:rgba(46,204,113,0.15);border:1px solid rgba(46,204,113,0.3);color:#2ecc71;border-radius:10px;padding:15px;margin-bottom:20px;">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
    </div>
}

<div class="form-card" style="max-width:500px;">
    <h5 style="color:#00c6ff;margin-bottom:20px;"><i class="fas fa-users me-2"></i>Generate Bill for All Residents</h5>
    <form method="post" action="/Bill/BulkCreate">
        <div class="mb-3">
            <label class="form-label">Month</label>
            <input type="text" name="month" class="form-control" placeholder="e.g. March 2026" required />
        </div>
        <div class="mb-4">
            <label class="form-label">Amount (₹)</label>
            <input type="number" name="amount" class="form-control" placeholder="Enter amount" required />
        </div>
        <div class="d-flex gap-3">
            <button type="submit" class="btn-save">
                <i class="fas fa-bolt me-2"></i>Generate for All Residents
            </button>
            <a href="/Bill/Index" class="btn-back">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </form>
</div>