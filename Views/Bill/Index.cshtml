@model List<SocietyManagementSystem.Models.MaintenanceBill>
@{
    ViewData["Title"] = "Maintenance Bills";
    Layout = "_Layout";
}

@if (TempData["Success"] != null)
{
    <div class="alert mb-3" style="background:rgba(46,204,113,0.15);border:1px solid rgba(46,204,113,0.3);color:#2ecc71;border-radius:10px;padding:15px;">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex gap-2">
        <a href="/Bill/Create" class="btn-add">
            <i class="fas fa-plus me-1"></i> Generate Bill
        </a>
        <a href="/Bill/BulkCreate" class="btn-add" style="background:linear-gradient(135deg,#9b59b6,#8e44ad);">
            <i class="fas fa-users me-1"></i> Generate for All
        </a>
    </div>
    <a href="/Bill/DownloadReport" class="btn-add" style="background:linear-gradient(135deg,#2ecc71,#27ae60);">
        <i class="fas fa-download me-1"></i> Download PDF Report
    </a>
</div>

<div class="d-flex gap-3 mb-3 align-items-center">
    <form method="get" action="/Bill/Index" class="d-flex gap-2 align-items-center">
        <select name="month" class="form-select" style="width:200px;" onchange="this.form.submit()">
            <option value="">-- All Months --</option>
            @foreach (var m in (List<string>)ViewBag.Months)
            {
                if (ViewBag.SelectedMonth == m)
                {
                    <option value="@m" selected>@m</option>
                }
                else
                {
                    <option value="@m">@m</option>
                }
            }
        </select>
    </form>
    <span style="color:#2ecc71;font-size:13px;"><i class="fas fa-check me-1"></i>Paid: @ViewBag.PaidCount</span>
    <span style="color:#e94560;font-size:13px;"><i class="fas fa-clock me-1"></i>Unpaid: @ViewBag.UnpaidCount</span>
</div>

<div class="card-custom">
    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="fas fa-file-invoice fa-3x mb-3" style="color:rgba(255,255,255,0.2)"></i>
            <p style="color:rgba(255,255,255,0.4)">No bills found. Generate your first bill!</p>
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Resident</th>
                    <th>Flat No</th>
                    <th>Amount</th>
                    <th>Month</th>
                    <th>Status</th>
                    <th>Paid On</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.Id</td>
                        <td>@b.Resident?.Name</td>
                        <td>@b.Resident?.FlatNumber</td>
                        <td>₹@b.Amount.ToString("0.##")</td>
                        <td>@b.Month</td>
                        <td>
                            @if (b.IsPaid)
                            {
                                <span class="badge-paid"><i class="fas fa-check me-1"></i>Paid</span>
                            }
                            else if (b.PaymentStatus == "Pending Verification")
                            {
                                <span class="badge-pending"><i class="fas fa-clock me-1"></i>Pending</span>
                            }
                            else
                            {
                                <span class="badge-unpaid"><i class="fas fa-clock me-1"></i>Unpaid</span>
                            }
                        </td>
                        <td>@(b.PaidOn.HasValue ? b.PaidOn.Value.ToString("dd MMM yyyy") : "-")</td>
                        <td>
                            @if (b.PaymentStatus == "Pending Verification")
                            {
                                @if (b.PaymentScreenshot != null)
                                {
                                    <a href="/uploads/@b.PaymentScreenshot" target="_blank" class="btn btn-sm btn-info me-1">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                }
                                <form method="post" action="/Bill/ApprovePayment/@b.Id" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-success me-1">
                                        <i class="fas fa-check"></i> Approve
                                    </button>
                                </form>
                            }
                            else if (b.IsPaid)
                            {
                                <span class="badge-paid"><i class="fas fa-check me-1"></i>Paid</span>
                            }
                            else
{
    <span style="color:rgba(255,255,255,0.3);font-size:12px;">Awaiting Payment</span>
}
                            <form method="post" action="/Bill/Delete/@b.Id" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>