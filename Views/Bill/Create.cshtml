@{
    ViewData["Title"] = "Generate Bill";
    Layout = "_Layout";
}

<div class="form-card" style="max-width:600px;">
    <form method="post" action="/Bill/Create">
        <div class="mb-3">
            <label class="form-label">Select Resident</label>
            <select name="ResidentId" class="form-select" required>
                <option value="">-- Select Resident --</option>
                @foreach (var r in ViewBag.Residents)
                {
                    <option value="@r.Id">@r.Name - Flat @r.FlatNumber</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Amount (₹)</label>
            <input type="number" name="Amount" class="form-control"
                   placeholder="Enter amount" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Month</label>
            <input type="text" name="Month" class="form-control"
                   placeholder="e.g. March 2026" required />
        </div>

        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn-save">
                <i class="fas fa-save me-2"></i>Generate Bill
            </button>
            <a href="/Bill/Index" class="btn-back">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </form>
</div>