CREATE TABLE `Users` (
  `Id` int NOT NULL AUTO_INCREMENT,
  `Name` longtext NOT NULL,
  `Email` longtext NOT NULL,
  `Password` longtext NOT NULL,
  `Role` longtext NOT NULL,
  `CreatedAt` datetime(6) NOT NULL,
  PRIMARY KEY (`Id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE `Residents` (
  `Id` int NOT NULL AUTO_INCREMENT,
  `Name` longtext NOT NULL,
  `FlatNumber` longtext NOT NULL,
  `Phone` longtext NOT NULL,
  `Email` longtext NOT NULL,
  `Address` longtext NOT NULL,
  `UserId` int NOT NULL,
  `JoinDate` datetime(6) NOT NULL,
  PRIMARY KEY (`Id`),
  KEY `IX_Residents_UserId` (`UserId`),
  CONSTRAINT `FK_Residents_Users_UserId` FOREIGN KEY (`UserId`) REFERENCES `Users` (`Id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE `Notices` (
  `Id` int NOT NULL AUTO_INCREMENT,
  `Title` longtext NOT NULL,
  `Content` longtext NOT NULL,
  `Category` longtext NOT NULL,
  `CreatedAt` datetime(6) NOT NULL,
  `ExpiryDate` datetime(6) NULL,
  PRIMARY KEY (`Id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE `Complaints` (
  `Id` int NOT NULL AUTO_INCREMENT,
  `ResidentId` int NOT NULL,
  `Title` longtext NOT NULL,
  `Description` longtext NOT NULL,
  `Status` longtext NOT NULL,
  `CreatedAt` datetime(6) NOT NULL,
  `ResolvedAt` datetime(6) NULL,
  PRIMARY KEY (`Id`),
  KEY `IX_Complaints_ResidentId` (`ResidentId`),
  CONSTRAINT `FK_Complaints_Residents_ResidentId` FOREIGN KEY (`ResidentId`) REFERENCES `Residents` (`Id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE `MaintenanceBills` (
  `Id` int NOT NULL AUTO_INCREMENT,
  `ResidentId` int NOT NULL,
  `Amount` decimal(65,30) NOT NULL,
  `Month` longtext NOT NULL,
  `IsPaid` tinyint(1) NOT NULL,
  `PaidOn` datetime(6) NULL,
  `CreatedAt` datetime(6) NOT NULL,
  `PaymentScreenshot` longtext NULL,
  `PaymentStatus` longtext NOT NULL,
  PRIMARY KEY (`Id`),
  KEY `IX_MaintenanceBills_ResidentId` (`ResidentId`),
  CONSTRAINT `FK_MaintenanceBills_Residents_ResidentId` FOREIGN KEY (`ResidentId`) REFERENCES `Residents` (`Id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE `ParkingSlots` (
  `Id` int NOT NULL AUTO_INCREMENT,
  `SlotNumber` longtext NOT NULL,
  `VehicleType` longtext NOT NULL,
  `IsOccupied` tinyint(1) NOT NULL,
  `ResidentId` int NULL,
  `VehicleNumber` longtext NOT NULL,
  PRIMARY KEY (`Id`),
  KEY `IX_ParkingSlots_ResidentId` (`ResidentId`),
  CONSTRAINT `FK_ParkingSlots_Residents_ResidentId` FOREIGN KEY (`ResidentId`) REFERENCES `Residents` (`Id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE `Visitors` (
  `Id` int NOT NULL AUTO_INCREMENT,
  `Name` longtext NOT NULL,
  `Phone` longtext NOT NULL,
  `Purpose` longtext NOT NULL,
  `ResidentId` int NOT NULL,
  `VisitDate` datetime(6) NOT NULL,
  `Status` longtext NOT NULL,
  PRIMARY KEY (`Id`),
  KEY `IX_Visitors_ResidentId` (`ResidentId`),
  CONSTRAINT `FK_Visitors_Residents_ResidentId` FOREIGN KEY (`ResidentId`) REFERENCES `Residents` (`Id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

